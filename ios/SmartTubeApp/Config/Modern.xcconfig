//
// Modern.xcconfig - For modern iOS devices (iOS 17.0 - 18.0+)
// Full features: Liquid Glass UI, 4K/8K HDR, PiP, Swift 6 Concurrency
//
#include? "Secrets.xcconfig"

IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ENABLE_USER_SCRIPT_SANDBOXING = YES
MARKETING_VERSION = 5.1
CURRENT_PROJECT_VERSION = 3
PRODUCT_BUNDLE_IDENTIFIER = com.dsnbw.smarttube
PRODUCT_NAME = SmartTube
